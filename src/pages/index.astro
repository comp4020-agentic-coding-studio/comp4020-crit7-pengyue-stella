---
import { listEvents } from "../lib/db";
import "../styles.css";

// Checkpoint 1: persistence foundation only — the real Discover feed
// (filters, cards, save) lands in the next checkpoint.
const upcoming = listEvents();
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ANU Discover</title>
  </head>
  <body>
    <nav aria-label="site">
      <a href="/">Discover</a>
      <a href="/readme/">About</a>
    </nav>
    <main>
      <h1>ANU Discover</h1>
      <ul>
        {
          upcoming.map((event) => (
            <li>
              {event.title} — {event.category} — {event.startsAt} — {event.location}
            </li>
          ))
        }
      </ul>
    </main>
  </body>
</html>
