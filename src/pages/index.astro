---
import { listColleges, listEvents, savedEventIds, type When } from "../lib/db";
import { INTENTS, MODES, type Intent, type Mode } from "../lib/schema";
import "../styles.css";

// Progressive reduction: the first screen asks one question — what the
// student wants out of the next few days — and shows no events at all until
// they answer it. Only once an intent narrows the catalogue to a small set
// do the practical filters (when/mode/free) appear, to narrow further rather
// than to browse. Every state is still a plain link (?intent=&when=...), so
// the flow works with no client JS and desktop/mobile behave identically.
const WHEN_OPTIONS: { value: When; label: string }[] = [
  { value: "today", label: "Today" },
  { value: "week", label: "This week" },
  { value: "weekend", label: "Weekend" },
];

const intentParam = Astro.url.searchParams.get("intent");
const intent = INTENTS.some((option) => option.value === intentParam) ? (intentParam as Intent) : undefined;

const whenParam = Astro.url.searchParams.get("when");
const when = WHEN_OPTIONS.some((option) => option.value === whenParam) ? (whenParam as When) : undefined;

const modeParam = Astro.url.searchParams.get("mode");
const mode = MODES.some((option) => option.value === modeParam) ? (modeParam as Mode) : undefined;

const free = Astro.url.searchParams.get("free") === "true";

// Colleges are scoped to intent only (not the practical filters), so the
// chip list stays stable while a student toggles when/mode/free/college —
// the same reason the when/mode chips themselves never disappear.
const colleges = intent ? listColleges(intent) : [];
const collegeParam = Astro.url.searchParams.get("college");
const college = collegeParam && colleges.includes(collegeParam) ? collegeParam : undefined;

// Nothing renders without a chosen intent — there is no "browse everything" state.
const events = intent ? listEvents({ intent, when, mode, free, college }) : [];
const saved = savedEventIds();
const returnTo = Astro.url.pathname + Astro.url.search;

function filterLink(next: {
  intent?: Intent | undefined;
  when?: When | undefined;
  mode?: Mode | undefined;
  free?: boolean | undefined;
  college?: string | undefined;
}): string {
  const params = new URLSearchParams();
  const nextIntent = "intent" in next ? next.intent : intent;
  const nextWhen = "when" in next ? next.when : when;
  const nextMode = "mode" in next ? next.mode : mode;
  const nextFree = "free" in next ? next.free : free;
  const nextCollege = "college" in next ? next.college : college;
  if (nextIntent) params.set("intent", nextIntent);
  if (nextWhen) params.set("when", nextWhen);
  if (nextMode) params.set("mode", nextMode);
  if (nextFree) params.set("free", "true");
  if (nextCollege) params.set("college", nextCollege);
  const qs = params.toString();
  return qs ? `/?${qs}` : "/";
}

const dateFormatter = new Intl.DateTimeFormat("en-AU", {
  weekday: "short",
  day: "numeric",
  month: "short",
  hour: "numeric",
  minute: "2-digit",
});

const intentLabel = INTENTS.find((option) => option.value === intent)?.label;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ANU Discover</title>
  </head>
  <body>
    <nav aria-label="site">
      <a href="/" aria-current="page">Discover</a>
      <a href="/my-events">My Events</a>
      <a href="/readme/">About</a>
    </nav>
    <main>
      <h1>ANU Discover</h1>
      {
        intent ? (
          <p class="tagline">
            Showing what's worth your attention for: <strong>{intentLabel}</strong> — <a href="/">choose a different goal</a>
          </p>
        ) : (
          <p class="tagline">What do you want to get out of the next few days?</p>
        )
      }

      {
        !intent ? (
          <ul class="intent-grid" aria-label="what do you want to do">
            {INTENTS.map((option) => (
              <li>
                <a class="intent-tile" href={filterLink({ intent: option.value })}>
                  {option.label}
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <>
            <div class="filters">
              <ul class="filter-row" aria-label="filter by time">
                <li>
                  <a href={filterLink({ when: undefined })} aria-current={when === undefined ? "true" : undefined}>
                    Any time
                  </a>
                </li>
                {WHEN_OPTIONS.map((option) => (
                  <li>
                    <a
                      href={filterLink({ when: option.value })}
                      aria-current={when === option.value ? "true" : undefined}
                    >
                      {option.label}
                    </a>
                  </li>
                ))}
              </ul>
              <ul class="filter-row" aria-label="filter by mode and price">
                <li>
                  <a href={filterLink({ mode: undefined })} aria-current={mode === undefined ? "true" : undefined}>
                    On campus or online
                  </a>
                </li>
                {MODES.map((option) => (
                  <li>
                    <a
                      href={filterLink({ mode: option.value })}
                      aria-current={mode === option.value ? "true" : undefined}
                    >
                      {option.label}
                    </a>
                  </li>
                ))}
                <li>
                  <a href={filterLink({ free: free ? undefined : true })} aria-current={free ? "true" : undefined}>
                    Free
                  </a>
                </li>
              </ul>
              {colleges.length > 0 && (
                <ul class="filter-row" aria-label="filter by college or school">
                  <li>
                    <a
                      href={filterLink({ college: undefined })}
                      aria-current={college === undefined ? "true" : undefined}
                    >
                      All colleges
                    </a>
                  </li>
                  {colleges.map((name) => (
                    <li>
                      <a href={filterLink({ college: name })} aria-current={college === name ? "true" : undefined}>
                        {name}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>

            {events.length === 0 ? (
              <p class="empty-state">Nothing matches these filters right now — try widening them.</p>
            ) : (
              <ul class="event-grid">
                {events.map((event) => (
                  <li class="event-card">
                    <a class="event-card-link" href={`/events/${event.id}`} aria-label={`View details: ${event.title}`} />
                    <div class="event-card-media">
                      <img src={event.imageUrl} alt="" width="400" height="240" loading="lazy" />
                    </div>
                    <div class="event-card-body">
                      <p class="event-college">{event.college}</p>
                      <h2>{event.title}</h2>
                      <p class="event-when">{dateFormatter.format(new Date(event.startsAt))}</p>
                      <p class="event-location">{event.location}</p>
                      <p class="event-description">{event.description}</p>
                      {saved.has(event.id) ? (
                        <p class="saved-badge">Saved</p>
                      ) : (
                        <form method="POST" action="/api/saved-events" class="save-form">
                          <input type="hidden" name="eventId" value={event.id} />
                          <input type="hidden" name="returnTo" value={returnTo} />
                          <button type="submit">Save</button>
                        </form>
                      )}
                    </div>
                  </li>
                ))}
              </ul>
            )}
          </>
        )
      }
    </main>
  </body>
</html>
